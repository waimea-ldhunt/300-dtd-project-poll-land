{#=====================================================
  Login page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}| {{user.username}} | Profile{% endblock%}

{% block content %}
    <h2>{{user.username}}</h2>
    <h3>Creator</h3>

    {% if session and session.user.is_admin == 1%}
        <button><a href="/user/{{user.id}}/delete">Delete Account</a></button>
    {% endif %}
    
    <h4>Creator's Public Polls</h4>
    {% if polls %}
        {% for poll in polls %}

            <h3>{{poll.title}}</h3>
            <h4>{{poll.subtitle}}</h4>

            {% for option in options %}
                {% if option.poll_id == poll.id %}

                    <div class="row">

                        {% if session.logged_in and (poll.id, session.user.id) in vote_groups %}

                            {% if option.id == ( votes | selectattr('poll_id', 'eq', poll.id) | list | selectattr('user_id', 'eq', session.user.id) | list | first ).option_id %}
                                <button><a href="/poll/{{poll.id}}/unvote" class="button">{{option.text}} [Remove Vote]</a></button>
                            {% else %}
                                <button><a href="/poll/{{poll.id}}/vote/{{option.id}}" class="button">{{option.text}} [Change Vote]</a></button>
                            {% endif%}

                        {% else %}

                            {% if not session.logged_in %}
                                <button disabled>{{option.text}}</button>
                            {% else %}
                                <button><a href="/poll/{{poll.id}}/vote/{{option.id}}" class="button">{{option.text}}</a></button>
                            {% endif %}

                        {% endif %}

                        <p>{{ votes | selectattr('option_id', 'eq', option.id) | list | count }}</p>

                    </div>

                {% endif %}
            {% endfor %}

            {% if  poll.is_public == 1 %}
                {% if comments | selectattr('poll_id', 'eq', poll.id) | list %}

                    <h5>Comments</h5> 

                    {% for comment in comments %}
                        {% if comment.poll_id == poll.id %}
                            <p>{{comment.text}} - <b>{{users[comment.user_id].username}}</b> - {% if session.logged_in and comment.user_id == session.user.id %}<a href="/comment/{{comment.id}}/delete">Delete</a>{% endif %}</p>
                        {% endif %} 
                    {% endfor%}

                {% else %}

                    <h5>There are no comments</h5>

                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endblock %}

