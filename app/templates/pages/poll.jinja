{#=====================================================
  Login page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %} | Login{% endblock%}

{% block content %}

    <h2>{{poll.title}}</h2>
    <h3>{{poll.subtitle}}</h3>

    {% if poll.image_path %}
        <img class="hero" src="/static/uploads/{{poll.image_path}}">
    {% endif %}

    {% if votes %}
        <div>
          <canvas class="pie_chart" data-poll_labels="{{labels}}", data-poll_data="{{data}}"></canvas>
        </div>

        <script src="/static/js/poll.js"></script>
    {% endif %}

    <div class="row">
        {% for option in options %}
            <h4>{{option.text}}</h4>
        {% endfor %}
    </div>

    {% if  poll.is_public == 1 and comments %}
        {% for comment in comments %}
            <p>{{comment.text}} - <b>{{users[comment.user_id].username}}</b></p>
        {% endfor %}
    {% endif %}

    <div class="row">
        <a href="/poll/{{poll.id}}/edit" class="button">Edit</a>
        <a href="/poll/{{poll.id}}/delete" class="button">Delete</a>
    </div>

    <h3>Analysis</h3>

    <p>{{votes | count}} participants have voted{% if poll.is_public == 0 %}, out of {{participants | count}} total participants{% endif %}</p>


    <table>
        <tr>
          <th>Option</th>
          <th>Votes</th>
          <th>Percentage</th>
        </tr>

        {% for option in options %}
            <tr>

                <td>{{option.text}}</td>
                <td>{{ votes | selectattr('option_id', 'eq', option.id) | list | count }}</td>

                {% if votes %}
                    <td>{{ ((votes | selectattr('option_id', 'eq', option.id) | list | count) / (votes | count)) * 100 | round(1) }}%</td>
                {% else %}
                    <td>0%</td>
                {% endif %}

            </tr>
        {% endfor %}

    </table>


{% endblock %}

