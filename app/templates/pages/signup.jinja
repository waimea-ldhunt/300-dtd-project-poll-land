{#=====================================================
  Signup page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Sign Up</h2>

    <form method="POST" action="/account/create">
        <label>
            <div class="row">
                Username
                <sub>*Case Sensitive</sub>
            </div>
            <input name="username" type="text" required>
            
        </label>

        <label>
            Password
            <input name="password" type="password" required>
        </label>

        <label>
            <div class="row">
                I am a Creator
                <input name="is_creator" type="checkbox">
            </div>
        </label>

        <button type="submit" >Sign Up</button>
    </form>

    <button><a href="/login" class="button">Log In Instead</a></button>

{% endblock %}

