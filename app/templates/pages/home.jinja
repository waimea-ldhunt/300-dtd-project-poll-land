{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Pollland</h2>

    {% for poll in polls %}

        {% if poll.is_public == 1 or (session.logged_in and (poll.id, session.user.id) in participant_groups) %}

            <h3>{{poll.title}}</h3>
            <h4>{{poll.subtitle}}</h4>
            <h5> - {{users[poll.owner_id].username}}</h5>

            {% for option in options %}
                {% if option.poll_id == poll.id %}

                    <div class="row">

                        {% if session.logged_in and (poll.id, session.user.id) in vote_groups %}
                            {% if option.id == ( votes | selectattr('poll_id', 'eq', poll.id) | list | selectattr('user_id', 'eq', session.user.id) | list | first ).option_id %}

                                <button><a href="/poll/{{poll.id}}/unvote" class="button">{{option.text}} [Remove Vote]</a></button>

                            {% else %}

                                <button><a href="/poll/{{poll.id}}/vote/{{option.id}}" class="button">{{option.text}} [Change Vote]</a></button>

                            {% endif%}

                        {% else %}

                            {% if ( not session.logged_in ) or ( session.logged_in and (poll.owner_id == session.user.id or session.user.is_admin == 1) )%}

                                <button disabled>{{option.text}}</button>

                            {% else %}

                                <button><a href="/poll/{{poll.id}}/vote/{{option.id}}" class="button">{{option.text}}</a></button>

                            {% endif %}
                        {% endif %}

                        <p>{{ votes | selectattr('option_id', 'eq', option.id) | list | count }}</p>

                    </div>

                {% endif %}
            {% endfor %}

            {% if session.logged_in and (poll.owner_id == session.user.id or session.user.is_admin == 1) %}
                <a href="/">Close Poll</a>
            {% endif %}

            {% if comments %} <h5>Comments</h5> {% endif %}

            {% for comment in comments %}
                {% if comment.poll_id == poll.id %}
                    <p>{{comment.text}} - <b>{{users[comment.user_id].username}}</b></p>
                {% endif %}
            {% endfor%}

        {% endif %}

    {% endfor %}

{% endblock %}