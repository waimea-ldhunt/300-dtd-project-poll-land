{#=====================================================
  Login page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %} | Create{% endblock%}

{% block content %}
    <h2>Create Poll</h2>

    <form method="POST" action="/poll/create" enctype="multipart/form-data">

        Title
        <input name="title" type="text" required>


        Subtitle
        <input name="subtitle" type="text">



        Image
        <input
            name="image"
            type="file"
            class="file"
            accept="image/png, image/jpeg, image/gif"
        >

        

        <span class="row">
            Public
            <input name="is_creator" type="checkbox" id="public_switch">
        </span>

        <span class="row">
            Participants
            <input name="participants" type="range" min="2" max="{{usercount}}" value="{{usercount}}" id="participant_range">
            <output id="range_output">{{usercount}}</output>
        </span>
        
        <div id="options_container">

                <input name="option" type="text" placeholder="Enter Option Text" required>

                <input name="option" type="text" placeholder="Enter Option Text" required>

        </div>

        <button type="button" id="add_option_button" class="blue">Add Option</button>

        <button type="submit">Create Poll</button>
    </form>

    <script src="/static/js/poll_form.js"></script>
{% endblock %}

