{#=====================================================
  Edit Poll Form page
=======================================================
  Edit poll form, Change the title, subtitle, and
  image of a poll, (options and participants
  cannot be changed)
-----------------------------------------------------#}

{% extends 'pages/_base.jinja' %}

{% block title %} | Edit{% endblock%}

{% block content %}

    <h2>Edit Poll</h2>

    <form method="POST" action="/poll/{{poll.id}}/update"  enctype="multipart/form-data">

        Title
        <input name="title" type="text" value="{{poll.title}}" required>

        Subtitle
        <input name="subtitle" type="text" value="{{poll.subtitle}}">
        

        {% if poll.image_path %}
            <img src="/static/uploads/{{poll.image_path}}" alt="Poll Hero Image">
        {% endif %}


        Image
        <input
            name="image"
            type="file"
            class="file"
            accept="image/png, image/jpeg, image/gif"
        >
        
        <span class="row">
            Public
            <input name="is_creator" type="checkbox" id="public_switch" {% if poll.is_public == 1 %} checked {% endif %} disabled>
        </span>



        <span class="row">
            Participants
            <input name="participants" type="range" min="2" max="{{participants}}" value="{{participants}}" disabled>
            <output id="range_output">{{participants}}</output>
        </span>
        
        <div>
            {% for option in options %}
                    <input name="option" type="text" value="{{option.text}}" disabled>
            {% endfor %}
        </div>

        <button type="submit">Save Changes</button>
    </form>

    <a href="/poll/{{poll.id}}/delete" class="button">Delete Poll</a>

{% endblock %}

