{#=====================================================
  Participating page
=======================================================
  Displays all private polls that the user is
  participating in (No Commenting)
-----------------------------------------------------#}

{% extends 'pages/_base.jinja' %}

{% block title %} | My Polls{% endblock%}

{% block content %}

    <h1>Participating</h1>

    {% if participating_polls %}

        {# Shows count of polls the user is participating in #}
        {% if participating_polls | count == 1%}
            <h2>We have 1 poll for you today!</h2>
        {% else %}
            <h2>We have {{participating_polls | count}} polls for you today!</h2>
        {% endif %}

        {% for poll in participating_polls%}

       <section class="poll">

          <h3>{{polls[poll.poll_id].title}}</h3>
          <h4>{{polls[poll.poll_id].subtitle}}</h4>
          <div class="user_card">
              <img class="profile" src="/static/uploads/{{users[polls[poll.poll_id].owner_id].image_path}}" alt="{{users[polls[poll.poll_id].owner_id]}} Profile Image">
              <a href="/profile/{{polls[poll.poll_id].owner_id}}"><h5>{{users[polls[poll.poll_id].owner_id].username}}</h5></a>
          </div>
  
          {% if polls[poll.poll_id].image_path %}
              <img src="/static/uploads/{{polls[poll.poll_id].image_path}}" alt="Poll Hero Image">
          {% endif %}
  
          <div class="options" id="poll_{{poll.poll_id}}">
  
              {% for option in options %}
                  {% if option.poll_id == poll.poll_id %}
                      <div class="row">

                            {# Checks if the user's vote in the poll matches the option id #}
                            {% if (poll.id, session.user.id) in vote_groups %}

                              {% if option.id == ( votes | selectattr('poll_id', 'eq', poll.poll_id) | list | selectattr('user_id', 'eq', session.user.id) | list | first ).option_id %}
                                  <a href="/poll/{{poll.poll_id}}/unvote" class="voted">{{option.text}}</a>
                              {% else %}
                                  <a href="/poll/{{poll.poll_id}}/vote/{{option.id}}" class="not_voted">{{option.text}}</a>
                              {% endif%}

                          {% endif %}
                      </div>
                  {% endif %}
              {% endfor %}
          </div>

        </section>

      {% endfor %}

    {% else %}

      <h2>We have no polls for you today.</h2>

    {% endif %}

{% endblock %}