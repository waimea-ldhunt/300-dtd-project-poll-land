{#=====================================================
  Login page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Log In</h2>

    <form method="POST" action="/account/login">
        <label>
            Username
            <input name="username" type="text" required>
        </label>

        <label>
            Password
            <input name="password" type="password" required>
        </label>

        <button type="submit" >Log In</button>
    </form>

    <button><a href="/signup" class="button">Sign Up Instead</a></button>

{% endblock %}

