{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Notes Demo {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        <a href="/">
            Pollland
        </a>

        <nav>
            <a href="/">Home</a>
            {% if session.logged_in %}
                <a href="/">Profile</a>
                <a href="/">Polls</a>
                <a href="/logout">Log Out</a>
                {% if session.user.is_creator == 1 %}
                    <p>{{session.user.username}} [Creator]</p>
                {% elif session.user.is_admin == 1 %}
                    <p>{{session.user.username}} [Admin]</p>
                {% else %}
                    <p>{{session.user.username}}</p>
                {% endif %}
            {% else %}
                <a href="/login">Log In</a
            {% endif %}
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>