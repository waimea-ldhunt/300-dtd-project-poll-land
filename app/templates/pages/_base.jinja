{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Pollland {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>


    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        <a href="/">
            <img src="/static/images/pollland-logo.png" alt="Pollland Logo">
        </a>

        <nav>
            <a href="/">Home</a>
                
            {% if session.logged_in%}

                {% if session.user.is_admin == 1 %}

                    <a href="/">All Polls</a>

                {% elif session.user.is_creator == 1 %}

                    <a href="/create">Create Poll</a>

                {% else %}

                    <a href="/participating">My Polls</a>

                {% endif %}

                <a href="/profile/{{session.user.id}}">Profile</a>

                <h3>{{session.user.username}}</h3>

            {% else  %}

                <a href="/login">Log In</a>

            {% endif %}

            
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

    <footer>
    
        {% if session.logged_in%}

            {% if session.user.is_creator == 1 %}

                <a href="/create"><img src="/static/images/pie.svg"></a>

            {% elif session.user.is_admin == 0 %}

                <a href="/participating"><img src="/static/images/pie.svg"></a>

            {% endif %}

            <a href="/"><img src="/static/images/home.svg"></a>
            <a href="/profile/{{session.user.id}}"><img src="/static/images/profile.svg"></a>

        {% endif %}

    </footer>

</body>

</html>     